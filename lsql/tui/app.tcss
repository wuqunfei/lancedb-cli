Screen {
    layout: vertical;
}

#root {
    height: 1fr;
}

#left-column {
    width: 34;
    height: 1fr;
}

#right-column {
    width: 1fr;
    height: 1fr;
}

DatabasePanel {
    height: auto;
    border: round $primary;
    padding: 0 1;
}

#db-path-input {
    margin-top: 0;
}

#database-panel-actions {
    height: 1;
    margin-top: 1;
}

#open-db-button {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
}

#theme-toggle-button {
    height: 1;
    min-width: 0;
    width: 4;
    border: none;
    padding: 0 1;
    margin-left: 1;
    background: transparent;
}

#theme-toggle-button:hover {
    background: transparent;
}

#theme-toggle-button:focus {
    background: transparent;
    text-style: none;
}

EmbeddingModelPanel {
    height: auto;
    border: round $primary;
    padding: 0 1;
}

#embedding-model-input {
    margin-top: 0;
}

#embedding-panel-actions {
    height: 1;
    margin-top: 1;
}

#set-embedding-button {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
}

EmbeddingModelDownloadModal {
    align: center middle;
}

#embedding-modal-dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#embedding-modal-title {
    height: 1;
    text-style: bold;
}

#embedding-modal-spinner {
    height: 3;
}

#embedding-modal-status {
    height: auto;
    color: $text-muted;
    margin-top: 1;
}

#embedding-modal-buttons {
    height: 1;
    margin-top: 1;
    align: right middle;
}

#embedding-modal-retry, #embedding-modal-cancel {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
    margin-left: 2;
}

TableListPanel {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#table-list {
    height: 1fr;
}

CommandInputPanel {
    height: auto;
    border: round $accent;
    padding: 0 1;
}

#status-line {
    color: $text-muted;
    height: 1;
}

#command-suggestions {
    height: auto;
    max-height: 8;
    border: round $accent;
}

ResultsPanel {
    height: 1fr;
    border: round $accent;
    padding: 0 1;
}

#results-table {
    height: 1fr;
}

#results-static {
    height: 1fr;
}

#pagination-bar {
    height: 1;
    align: center middle;
}

#pagination-label {
    width: 1fr;
    content-align: center middle;
}

#prev-page-button, #next-page-button {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
}

ConfirmModal {
    align: center middle;
}

#confirm-dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    border: thick $error;
    background: $surface;
}

#confirm-message {
    width: 1fr;
    content-align: center middle;
    margin-bottom: 1;
}

#confirm-buttons {
    height: 1;
    align: center middle;
}

#confirm-yes, #confirm-no {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
    margin: 0 1;
}

ConfirmProgressModal {
    align: center middle;
}

#confirm-progress-dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    border: thick $error;
    background: $surface;
}

#confirm-progress-message {
    width: 1fr;
    content-align: center middle;
    margin-bottom: 1;
}

#confirm-progress-spinner {
    height: 3;
    margin-bottom: 1;
}

#confirm-progress-buttons {
    height: 1;
    align: center middle;
}

#confirm-progress-yes, #confirm-progress-no {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
    margin: 0 1;
}

DirectoryBrowserModal {
    align: center middle;
}

#browser-dialog {
    width: 70;
    height: 18;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#browser-header {
    height: 1;
}

#browser-title {
    height: 1;
    text-style: bold;
    content-align: left middle;
    margin-left: 2;
}

#browser-up {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
}

#browser-tree {
    height: 1fr;
    margin-top: 1;
}

#browser-selected-path {
    height: 1;
    margin-top: 1;
    color: $text-muted;
}

#browser-buttons {
    height: auto;
    margin-top: 1;
    align: right middle;
}

#browser-open, #browser-cancel {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
    margin-left: 2;
}

CellDetailModal {
    align: center middle;
}

#cell-detail-dialog {
    width: 70;
    height: 20;
    padding: 1 2;
    border: thick $accent;
    background: $surface;
}

#cell-detail-title {
    height: 1;
    text-style: bold;
}

#cell-detail-value {
    height: 1fr;
    margin-top: 1;
    border: solid $primary-darken-1;
}

#cell-detail-buttons {
    height: auto;
    margin-top: 1;
    align: right middle;
}

#cell-detail-copy, #cell-detail-update, #cell-detail-close {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
    margin-left: 2;
}
